{
  "name": "dsa-revision-buddy",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that syncs your LeetCode/Codeforces solutions to GitHub and schedules them for spaced-repetition revision.",
  "type": "module",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "npm run clean && npm run build:pages && npm run build:scripts && npm run build:assets",
    "build:pages": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
