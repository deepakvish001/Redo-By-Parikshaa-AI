{
  "name": "redo",
  "version": "1.0.0",
  "private": true,
  "description": "Commit your accepted DSA solutions to GitHub, then actually remember them with spaced repetition and weak-topic analytics.",
  "type": "module",
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "npm run clean && npm run build:pages && npm run build:scripts && npm run build:assets",
    "build:pages": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "rename": "node scripts/rename.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^30.0.1",
    "linkedom": "^0.18.13",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "license": "MIT"
}
