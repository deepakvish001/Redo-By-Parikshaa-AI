{
  "manifest_version": 3,
  "name": "Redo \u2014 DSA revision that sticks",
  "version": "1.0.0",
  "description": "Commit your accepted DSA solutions to GitHub, then actually remember them with spaced repetition and weak-topic analytics.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetcode.cn/*",
    "https://codeforces.com/*",
    "https://*.codeforces.com/*",
    "https://atcoder.jp/*",
    "https://www.codechef.com/*",
    "https://www.hackerrank.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://practiceapi.geeksforgeeks.org/*",
    "https://api.github.com/*",
    "https://parikshaa.org/*",
    "https://www.parikshaa.org/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Redo \u2014 open the revision panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/index.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://www.codechef.com/*",
        "https://www.hackerrank.com/*",
        "https://www.geeksforgeeks.org/problems/*"
      ],
      "js": [
        "observer.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*",
        "https://codeforces.com/*",
        "https://*.codeforces.com/*",
        "https://atcoder.jp/*",
        "https://www.codechef.com/*",
        "https://www.hackerrank.com/*",
        "https://www.geeksforgeeks.org/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://parikshaa.org/*",
        "https://www.parikshaa.org/*"
      ],
      "js": [
        "parikshaa-injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://parikshaa.org/*",
        "https://www.parikshaa.org/*"
      ],
      "js": [
        "parikshaa.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "short_name": "Redo",
  "side_panel": {
    "default_path": "panel/index.html"
  }
}
